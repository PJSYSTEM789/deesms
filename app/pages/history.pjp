<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    loadHistory();
});

// ฟังก์ชันดึงข้อมูลประวัติการส่งจาก API
async function loadHistory() {
    const tbody = document.getElementById('historyTableBody');
    const startDate = document.getElementById('filterStartDate').value;
    const endDate = document.getElementById('filterEndDate').value;

    tbody.innerHTML = `
        <tr>
            <td colspan="5" class="text-center text-muted py-4">
                <i class="fa-solid fa-spinner fa-spin me-2"></i>กำลังดึงข้อมูล...
            </td>
        </tr>
    `;

    try {
        let url = `api/get_history.php?start_date=${startDate}&end_date=${endDate}`;
        let response = await fetch(url);
        let result = await response.json();

        if (result.success && Array.isArray(result.data) && result.data.length > 0) {
            tbody.innerHTML = '';
            result.data.forEach(item => {
                let statusStr = item.gateway_status || item.status || 'FAILED';
                let isSuccess = statusStr.toUpperCase() === 'SUCCESS';
                
                let statusBadge = isSuccess 
                    ? '<span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>สำเร็จ</span>' 
                    : `<span class="badge bg-secondary">${statusStr}</span>`;

                let senderName = item.sender?.name || item.sender_name || item.send_from || '-';
                let phone = item.recipient || item.phone || '-';
                let message = item.message || '-';
                let createdAt = item.created_at || item.send_at || '-';

                tbody.innerHTML += `
                    <tr>
                        <td>${createdAt}</td>
                        <td class="fw-bold text-dark">${phone}</td>
                        <td><span class="badge bg-light text-dark border">${senderName}</span></td>
                        <td>${escapeHtml(message)}</td>
                        <td class="text-center">${statusBadge}</td>
                    </tr>
                `;
            });
        } else {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        ไม่พบประวัติการส่งในเงื่อนไขที่เลือก
                    </td>
                </tr>
            `;
        }
    } catch (e) {
        console.error("Load history error:", e);
        tbody.innerHTML = `
            <tr>
                <td colspan="5" class="text-center text-danger py-4">
                    เกิดข้อผิดพลาดในการโหลดประวัติการส่ง
                </td>
            </tr>
        `;
    }
}

// ฟังก์ชันช่วยป้องกันการแสดงผล XSS
function escapeHtml(text) {
    if (!text) return '';
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}
</script>

</body>
</html>
